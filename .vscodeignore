.vscode/**
.claude/**
.gitignore
.sandbox/**
# Chronos running on its own repository writes a real .chronos here: this
# folder's plans, transcripts, logs and schedule. `.chronos/.gitignore` keeps
# it out of git, but vsce reads this file and nothing else, so without this
# line every install ships one developer's private work.
.chronos/**
favicon.ico
# The raw manager and Tasks captures. Nothing in the extension loads them, and
# they are the unblurred originals: a real working-directory path and a real
# seven-day spend figure. They were half the size of the package. The blurred
# copies the landing page publishes live in `site/img/`, which is excluded below.
media/screenshots.png
media/screenshots-2.png
# The landing page is repo-only — a static site Cloudflare Pages serves from
# GitHub. It must never ship inside the .vsix.
site/**
docs/**
# The instance dashboard is developer tooling, started by hand with
# `npm run dashboard`. Nothing in the extension loads either folder — the
# extension's only half of it is `dist/extension.js` writing the heartbeat.
dashboard/**
scripts/**
test/**
src/**
dist-test/**
node_modules/**
esbuild.js
reinstall.js
tsconfig.json
tsconfig.test.json
**/*.map
**/*.ts
