{
  "name": "chronos",
  "displayName": "Chronos",
  "description": "Schedule Claude Code tasks from Markdown plan files.",
  "version": "0.8.0-rc.66",
  "publisher": "Z3n",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "scheduler",
    "automation",
    "markdown"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chronos",
          "title": "Chronos",
          "icon": "media/chronos.svg"
        }
      ]
    },
    "views": {
      "chronos": [
        {
          "id": "chronos.tasks",
          "name": "Tasks",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "chronos.openManager",
        "title": "Chronos: Open Manager",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "chronos.addFiles",
        "title": "Chronos: Schedule Markdown File...",
        "icon": "$(add)"
      },
      {
        "command": "chronos.scheduleFile",
        "title": "Schedule with Chronos"
      },
      {
        "command": "chronos.showLogs",
        "title": "Chronos: Show Logs"
      },
      {
        "command": "chronos.addTask",
        "title": "Chronos: Add Task",
        "icon": "$(add)"
      },
      {
        "command": "chronos.generatePlanRemote",
        "title": "Chronos: Generate Plan (Answer Remotely)..."
      },
      {
        "command": "chronos.selectFolder",
        "title": "Chronos: Select Folder",
        "icon": "$(folder)"
      },
      {
        "command": "chronos.copyMcpConfig",
        "title": "Chronos: Copy MCP Server Config..."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chronos.openManager",
          "when": "view == chronos.tasks",
          "group": "navigation@2"
        },
        {
          "command": "chronos.addFiles",
          "when": "view == chronos.tasks"
        }
      ],
      "explorer/context": [
        {
          "command": "chronos.scheduleFile",
          "when": "resourceExtname == .md",
          "group": "7_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "chronos.scheduleFile",
          "when": "resourceExtname == .md",
          "group": "1_chronos"
        }
      ],
      "commandPalette": [
        {
          "command": "chronos.scheduleFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Chronos",
      "properties": {
        "chronos.claudePath": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "Path to the `claude` executable. Leave as `claude` to resolve from PATH."
        },
        "chronos.opencodePath": {
          "type": "string",
          "default": "opencode",
          "markdownDescription": "Path to the `opencode` executable, for tasks whose engine is opencode."
        },
        "chronos.libraryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where plans are kept. Empty means `.chronos/plans` in the current folder."
        },
        "chronos.resultsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where run transcripts are written. Empty means `.chronos/results` in the current folder."
        },
        "chronos.planModel": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "claude-opus-5",
            "claude-opus-4-8",
            "claude-sonnet-5",
            "claude-haiku-4-5-20251001",
            "claude-fable-5",
            "opus",
            "sonnet",
            "haiku"
          ],
          "enumDescriptions": [
            "Account default",
            "Opus 5",
            "Opus 4.8",
            "Sonnet 5",
            "Haiku 4.5",
            "Fable 5",
            "Opus (latest)",
            "Sonnet (latest)",
            "Haiku (latest)"
          ],
          "markdownDescription": "Model used for the sessions you sit at — generating a plan, and explaining a task. Scheduled runs use each plan's own model."
        },
        "chronos.planStep.tests": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "End every generated plan by running the project test suite."
        },
        "chronos.planStep.version": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "End every generated plan by bumping the project version."
        },
        "chronos.planStep.changelog": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "End every generated plan by adding a changelog entry."
        },
        "chronos.planStep.rebuild": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "End every generated plan by rebuilding the project."
        },
        "chronos.planStep.reinstall": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "End every generated plan by reinstalling the project it just built."
        },
        "chronos.planStep.commit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "End every generated plan by committing the result to git."
        },
        "chronos.showTerminalOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the terminal panel when a task starts."
        },
        "chronos.maxConcurrent": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 5,
          "description": "Tasks allowed to run at once. Parallel agents in one repository will collide."
        },
        "chronos.maxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Retry attempts after a failed run."
        },
        "chronos.retryDelayMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Delay before retrying a failed run."
        },
        "chronos.graceWindowMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "description": "How late a task may fire and still run."
        },
        "chronos.idleTimeoutMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Kill a run that produces no output for this long."
        },
        "chronos.maxRuntimeMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Hard ceiling on a single run."
        },
        "chronos.logRetentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "Delete raw run logs older than this on startup."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist-test/test/",
    "pretest": "tsc -p tsconfig.test.json",
    "package": "npm run typecheck && npm run build && vsce package",
    "reinstall": "npm run package && node reinstall.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.93.0",
    "@vscode/codicons": "^0.0.46-24",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  }
}
