{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist-test",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "//": "Modules deliberately kept free of `vscode` so they run in plain Node.",
  "include": [
    "test/**/*.ts",
    "src/adopt.ts",
    "src/agents.ts",
    "src/command.ts",
    "src/dashboard-payload.ts",
    "src/decide.ts",
    "src/edit.ts",
    "src/history.ts",
    "src/launch.ts",
    "src/library.ts",
    "src/lock.ts",
    "src/mcp-clients.ts",
    "src/mcp-tools.ts",
    "src/migrate.ts",
    "src/outcome.ts",
    "src/recurrence.ts",
    "src/remote.ts",
    "src/results.ts",
    "src/roots.ts",
    "src/series.ts",
    "src/state-file.ts",
    "src/time.ts",
    "src/transcript.ts",
    "src/types.ts"
  ]
}
